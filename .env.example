# AUTO ANI Website - Environment Variables Template
# All vehicle data is now hardcoded - no external CMS needed!

# ============================================
# NEXT.JS (Development)
# ============================================
NODE_ENV=development

# Site URL (for metadata, sitemaps, and social sharing)
# Production: https://aniautosallon.com (primary domain)
# Alternative: https://autosalonani.com (redirects to primary)
# Staging: https://auto-ani-website-shzs.onrender.com
NEXT_PUBLIC_SITE_URL=https://aniautosallon.com

# ============================================
# CONTACT INFORMATION (Built into website)
# ============================================
NEXT_PUBLIC_WHATSAPP_NUMBER=38349204242
NEXT_PUBLIC_CONTACT_EMAIL=aniautosallon@gmail.com
NEXT_PUBLIC_PHONE_NUMBER=+38349204242

# ============================================
# CONTACT FORM (Optional - if using email service)
# ============================================
# RESEND_API_KEY=your_resend_api_key
# CONTACT_EMAIL=contact@autosalonani.com

# ============================================
# VERCEL FEATURES (Auto-populated by Vercel)
# ============================================
# Web Analytics - Tracks visitors and page views
# No configuration needed - works out of the box

# Speed Insights - Tracks Core Web Vitals (LCP, FID, CLS)
# No configuration needed - works out of the box

# Feature Flags - Enable in Vercel Dashboard
# EDGE_CONFIG=your_edge_config_connection_string
# This is auto-populated by Vercel when you create an Edge Config

# Vercel Toolbar - Automatically enabled in development
# Shows feature flags, comments, and deployment info

# ============================================
# STATSIG - Advanced Experimentation & Feature Flags
# ============================================
# These are auto-populated by Vercel when you create a Statsig integration
# Run `vercel env pull` to get your actual keys after creating the integration

# Server-side API key for Statsig (keep secret!)
STATSIG_SERVER_API_KEY=your_statsig_server_api_key

# Client-side key for Statsig (safe to expose)
NEXT_PUBLIC_STATSIG_CLIENT_KEY=your_statsig_client_key

# Experimentation config (auto-populated by Vercel)
EXPERIMENTATION_CONFIG=your_experimentation_config
EXPERIMENTATION_CONFIG_ITEM_KEY=your_experimentation_config_item_key

# ============================================
# DEPLOYMENT (Local Development)
# ============================================
PORT=3000