# AUTO ANI Website - Environment Variables Template
# ⚠️ SECURITY WARNING: Never commit actual API keys to version control!
# Copy this file to .env.local and fill in your actual values
# Keep .env.local in .gitignore (already configured)

# ============================================
# SANITY CMS (Required)
# ============================================
# Get from: https://www.sanity.io/manage/project/[your-project]
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# ⚠️ Use read-only token for production, never expose write tokens
# Generate from: Sanity dashboard > API > Tokens
SANITY_API_TOKEN=your_sanity_read_only_token

# ============================================
# NEXT.JS (Optional)
# ============================================
NODE_ENV=development

# ============================================
# CONTACT INFORMATION (Required)
# ============================================
NEXT_PUBLIC_WHATSAPP_NUMBER=38349204242
NEXT_PUBLIC_CONTACT_EMAIL=aniautosallon@gmail.com
NEXT_PUBLIC_PHONE_NUMBER=+38349204242

# ============================================
# CONTACT FORM (Optional)
# ============================================
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=contact@autosalonani.com

# ============================================
# DEPLOYMENT (Optional)
# ============================================
PORT=3000